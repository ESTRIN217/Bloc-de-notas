  "exercise_note": {
    "title": "Workout Routine!",
    "backgroundColor": 4294967295,
    "summary": [
      { "insert": "MASTER ROUTINE: STRENGTH AND ENDURANCE", "attributes": { "bold": true } },
      { "insert": "\n", "attributes": { "header": 1 } },
      { "insert": "Objective: Hypertrophy, power, and cardiovascular capacity.", "attributes": { "bold": true } },
      { "insert": "\n" },
      { "insert": "Weekly Schedule: M, T, Th, F", "attributes": { "bold": true } },
      { "insert": "\nBlock 1: Strength and Power (Hardest first)" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "Pull-ups (Bars):", "attributes": { "bold": true } },
      { "insert": " 3 sets of 8 if you want to increase volume. " },
      { "insert": "It is the exercise that consumes the most energy.", "attributes": { "italic": true } },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Pike Push-ups: 3 sets of 5 repetitions", "attributes": { "bold": true } },
      { "insert": ". If you can, put your feet on a chair to make them heavier." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Diamond Push-ups:", "attributes": { "bold": true } },
      { "insert": " 3 sets of 8 repetitions. " },
      { "insert": "They isolate the triceps while you still have strength.", "attributes": { "italic": true } },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Block 2: Push Endurance (Chest and Shoulders)" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "Australian Pull-ups (Inverted Row):", "attributes": { "bold": true } },
      { "insert": " 3 sets of 10 to 12 repetitions. Note: Try to make your chest touch the bar and lower with control." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Incline Push-ups (Feet on a chair):", "attributes": { "bold": true } },
      { "insert": " 3 sets of 12 repetitions." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Knuckle Push-ups:", "attributes": { "bold": true } },
      { "insert": " 20 repetitions." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Regular Push-ups:", "attributes": { "bold": true } },
      { "insert": " 3 sets of 10 repetitions." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Front Deltoids (Hold or dynamic):", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "15 repetitions", "attributes": { "bold": true } },
      { "insert": "." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Block 3: Lower Body (Legs)" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "Squats:", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "30 repetitions", "attributes": { "bold": true } },
      { "insert": ". Look for depth." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Explosive Squats:", "attributes": { "bold": true } },
      { "insert": " 3 sets of 15 repetitions." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Bulgarian Split Squats (Foot on a chair):", "attributes": { "bold": true } },
      { "insert": " 3 sets of 10 repetitions per leg." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Forward Lunges:", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "40 repetitions", "attributes": { "bold": true } },
      { "insert": " (20 per leg)." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Butt Bridge (Glute Bridge):", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "30 repetitions", "attributes": { "bold": true } },
      { "insert": ". Squeeze for 2 seconds at the top." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Leg in and out: 30 repetitions.", "attributes": { "bold": true } },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Block 4: Core and Final Cardio" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "Leg Raises:", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "25 repetitions", "attributes": { "bold": true } },
      { "insert": ". Do not let your feet touch the ground." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Mountain Climbers:", "attributes": { "bold": true } },
      { "insert": " " },
      { "insert": "100 repetitions", "attributes": { "bold": true } },
      { "insert": ". Do them fast to burn." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Planks:", "attributes": { "bold": true } },
      { "insert": " 3 sets of 1 minute (Rest only 30 seconds between sets)." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Block 5: Stretching and Flexibility" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "For recovery to be effective, hold each stretching posture for " },
      { "insert": "20 to 30 seconds", "attributes": { "bold": true } },
      { "insert": ", breathing deeply through your nose.\n" },
      { "insert": "Cat-Cow Flow:", "attributes": { "bold": true } },
      { "insert": " 10 cycles (to mobilize the spine after core work)." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Child’s Pose:", "attributes": { "bold": true } },
      { "insert": " With arms well extended forward to relax the lower back and shoulders." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Wall Chest Stretch:", "attributes": { "bold": true } },
      { "insert": " Place your forearm on a door frame or wall and twist your body to the opposite side. Vital after so many push-ups." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Triceps Stretch:", "attributes": { "bold": true } },
      { "insert": " Pass your elbow behind your head and push gently." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Downward Dog:", "attributes": { "bold": true } },
      { "insert": " Stretches the entire posterior chain (hamstrings, calves, and back)." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Hip Flexor Stretch (Cobra or Low Lunge):", "attributes": { "bold": true } },
      { "insert": " Crucial to avoid back pain if you spend a lot of time sitting down programming." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "Wrist Stretch:", "attributes": { "bold": true } },
      { "insert": " On your knees, place your palms on the floor with fingers pointing towards your knees and gently rock back and forth." },
      { "insert": "\n", "attributes": { "list": "ordered" } },
      { "insert": "How to progress with this list?" },
      { "insert": "\n", "attributes": { "header": 3 } },
      { "insert": "Rests:", "attributes": { "bold": true } },
      { "insert": " If you are looking for " },
      { "insert": "physical conditioning (fat burning and endurance)", "attributes": { "bold": true } },
      { "insert": ", try resting only 45-60 seconds between exercises." },
      { "insert": "\n", "attributes": { "list": "bullet" } },
      { "insert": "Increasing difficulty:", "attributes": { "bold": true } },
      { "insert": " When you feel that the 20 regular push-ups are easy, do them slower (3 seconds to lower, 1 second to rise). That is called \"time under tension\" and it is brutal for the muscle." },
      { "insert": "\n", "attributes": { "list": "bullet" } },
      { "insert": "Frequency:", "attributes": { "bold": true } },
      { "insert": " You can do this 3 or 4 times per week, leaving a rest day in between for the muscle to recover and grow." },
      { "insert": "\n", "attributes": { "list": "bullet" } },
      { "insert": "Hydration", "attributes": { "bold": true } },
      { "insert": ": By increasing leg reps and mountain climbers, you are going to sweat a lot more. Sip small amounts of water during rests." },
      { "insert": "\n", "attributes": { "list": "bullet" } },
      { "insert": "Listen to your wrists", "attributes": { "bold": true } },
      { "insert": ": Since you use the knuckle and diamond variations, if you feel too much pressure, you can slightly rotate your hand position. The knuckle variation is excellent for keeping the wrist neutral (straight), so use it to your advantage if you feel discomfort." },
      { "insert": "\n", "attributes": { "list": "bullet" } },
      { "insert": "Consistency", "attributes": { "bold": true } },
      { "insert": ": Try to maintain this order for at least 4 weeks before increasing repetitions again. The body needs time to adapt mechanically to the new angles." },
      { "insert": "\n", "attributes": { "list": "bullet" } }
    ]
  }
}